# ===== se-env: never commit keys or secrets (patterns match at any depth) =====
# Secure Enclave key reference and its public key
identity.txt
identity*.txt
recipient.txt
# Encrypted profiles and the key-name index
vault/
*.age
*.keys
# Session caches
run/
# Plaintext secret files, in case one is created while testing
.env
.env.*
!.env.example
*.pem
*.key

# ===== build outputs (see docs/build_mac.md, docs/build_win.md) =====
bin/
.build/
/src/
win/target/

# ===== OS / editor =====
.DS_Store
._*
*.swp
*~
.vscode/
.idea/
